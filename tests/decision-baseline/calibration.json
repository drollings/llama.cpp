{
  "note": "Calibration sign-off for the decision heuristics. Values are measurements, not tunables. Every row carries production_gate:false; confidence rows may never gate admission, caching, routing or persistence. Update only with a matching code change and a re-measured gate.",
  "rows": {
    "prefix_hoist": {
      "trigger": "prefix hoist length (>=32 shared tokens)",
      "axis": "task-value",
      "may_gate": [
        "prefix reuse decision"
      ],
      "may_not_gate": [
        "answers",
        "admission"
      ],
      "production_gate": false,
      "verdict": "hoist only on an exact shared token head of at least 32 tokens; near misses never hoist; prefix-reuse prefill delta recorded",
      "measurements": {
        "precision": 1.0,
        "recall": 1.0,
        "false_positives": 0,
        "false_negatives": 0,
        "pairs": 520,
        "outcome_tv_bound": 0.15,
        "outcome_argmax_agree": true
      },
      "control_group": {
        "cases": [
          {
            "input": "shared head at the hoist budget",
            "expect": "hoist"
          },
          {
            "input": "shared head below the hoist minimum",
            "expect": "no hoist"
          },
          {
            "input": "near-miss head",
            "expect": "no hoist"
          }
        ],
        "hoist_min_tokens": 4,
        "hoist_budget": 32
      }
    },
    "question_dedup": {
      "trigger": "question dedup on byte-identical suffix",
      "axis": "task-value",
      "may_gate": [
        "dedup of identical suffixes"
      ],
      "may_not_gate": [
        "near-duplicate collapse",
        "caching across states"
      ],
      "production_gate": false,
      "verdict": "dedup only on exact suffix equality; near duplicates never collapse",
      "measurements": {
        "exact_equal": 250,
        "near_equal": 0,
        "pair_suite": 250
      }
    },
    "confidence_diagnostics": {
      "trigger": "allowed_token_mass / full-vocab argmax diagnostics",
      "axis": "confidence",
      "may_gate": [],
      "may_not_gate": [
        "admission",
        "caching",
        "routing",
        "persistence",
        "answer validity"
      ],
      "production_gate": false,
      "verdict": "advisory-only; dashboard threshold, never a production gate",
      "measurements": {
        "auc": 1.0,
        "verdict": "advisory-only"
      }
    },
    "selected_head": {
      "trigger": "selected vs full head choice",
      "axis": "task-value",
      "may_gate": [
        "fast path vs full-logits path"
      ],
      "may_not_gate": [
        "admission",
        "caching",
        "routing",
        "persistence",
        "answer validity"
      ],
      "production_gate": false,
      "verdict": "fast path exists but is opt-in and off by default: it runs only when the context exposes hidden states, an explicit selected request on an incompatible model errors, and every other path falls back to full logits",
      "measurements": {
        "source_hits": 3,
        "available": false,
        "production_gate": false,
        "cases": 250,
        "precision": 1.0,
        "recall": 1.0,
        "false_positives": 0,
        "false_negatives": 0
      }
    },
    "head_context_selector": {
      "trigger": "head/context selector (classifier vs full logits)",
      "axis": "task-value",
      "may_gate": [
        "which context scores the request"
      ],
      "may_not_gate": [
        "admission",
        "caching",
        "routing",
        "persistence",
        "answer key"
      ],
      "production_gate": false,
      "verdict": "the classifier fast path is chosen only when the context is classifier-only, the head is available at the hidden width and covers every candidate; otherwise full logits, and the fallback is a capability metric only",
      "measurements": {
        "cases": 210,
        "precision": 1.0,
        "recall": 1.0,
        "false_positives": 0,
        "false_negatives": 0,
        "fallback_cases": 130,
        "fallback_rate": 0.6190476190476191,
        "fallback_reasons": {
          "non_classifier_context": 40,
          "uncovered_candidate": 30,
          "width_mismatch": 25,
          "unavailable_head": 20,
          "null_head": 15
        },
        "outcome_tv_bound": 0.05,
        "outcome_argmax_agree": true
      }
    },
    "head_vs_full": {
      "trigger": "head vs full producer equivalence",
      "axis": "task-value",
      "may_gate": [
        "whether the selected-head fast path may run"
      ],
      "may_not_gate": [
        "admission",
        "caching",
        "routing",
        "persistence"
      ],
      "production_gate": false,
      "verdict": "winner equality between the selected head and full logits is the task-value gate; total variation is producer confidence, recorded per model in model_measurements, never a gate; a family that flips a winner is refused statically in the classifier predicate, never by a runtime confidence threshold",
      "control_group": {
        "cases": [
          {
            "input": "selected head available on the model",
            "expect": "used"
          },
          {
            "input": "selected head unavailable",
            "expect": "falls back to full logits"
          },
          {
            "input": "winner disagrees on a family",
            "expect": "that family is refused statically"
          }
        ],
        "winner_axis": "task-value",
        "tv_axis": "producer confidence (recorded, never asserted as a gate)",
        "tv_bound": 0.05
      }
    },
    "adapter_scope": {
      "trigger": "adapter scope (base model only)",
      "axis": "task-value",
      "may_gate": [
        "which model identity answers"
      ],
      "may_not_gate": [
        "no-adapter head selection",
        "admission",
        "caching",
        "routing",
        "persistence"
      ],
      "production_gate": false,
      "verdict": "with adapters configured the decision is scoped to the base model: auto and full use base full logits, an explicit selected request is refused, and a no-adapter control still selects the head",
      "measurements": {
        "cases": 250,
        "policy_matches_expect": true,
        "precision": 1.0,
        "recall": 1.0,
        "false_positives": 0,
        "false_negatives": 0,
        "control_no_adapter_head": 90,
        "with_adapter_auto_full": 60,
        "with_adapter_selected_reject": 40,
        "with_adapter_full_full": 30,
        "production_gate": false
      }
    },
    "tree_vs_greedy": {
      "trigger": "tree vs greedy exactness and cost",
      "axis": "task-value",
      "may_gate": [
        "exact-vs-greedy mode choice"
      ],
      "may_not_gate": [
        "correctness claims",
        "caching"
      ],
      "production_gate": false,
      "verdict": "measured on the test model; model_measurements carry the numbers"
    },
    "single_question_bypass": {
      "trigger": "single-question fork bypass",
      "axis": "task-value",
      "may_gate": [
        "which scoring path runs"
      ],
      "may_not_gate": [
        "correctness",
        "admission"
      ],
      "production_gate": false,
      "verdict": "copy-fork only; bypass stays on by default and never runs on multi-question rounds or restore-fork memory; measured speedup recorded in model_measurements"
    },
    "auto_mode_boundary": {
      "trigger": "tree_max auto switch",
      "axis": "task-value",
      "may_gate": [
        "mode selection at the boundary"
      ],
      "may_not_gate": [
        "correctness claims"
      ],
      "production_gate": false,
      "verdict": "auto uses tree up to tree_max and greedy above; default pinned at 128",
      "control_group": {
        "cases": [
          {
            "input": "value count at tree_max default",
            "expect": "tree"
          },
          {
            "input": "value count above tree_max default",
            "expect": "greedy"
          },
          {
            "input": "explicit tree mode",
            "expect": "tree"
          },
          {
            "input": "explicit greedy mode",
            "expect": "greedy"
          }
        ],
        "tree_max_default": 128
      }
    },
    "temperature_profile": {
      "trigger": "calibrated temperature",
      "axis": "confidence",
      "may_gate": [
        "probability/confidence values only"
      ],
      "may_not_gate": [
        "admission",
        "caching",
        "routing",
        "persistence",
        "answer key"
      ],
      "production_gate": false,
      "verdict": "T=1.0 default; non-default needs matching provenance; stale profile refused",
      "measurements": {
        "match_accepted": 1,
        "mismatch_refused": 4,
        "mismatch_cases": 4
      }
    },
    "admission_control": {
      "trigger": "single decision request at max_queue defaults",
      "axis": "resource",
      "may_gate": [
        "how many concurrent decisions run"
      ],
      "may_not_gate": [
        "single-request rejection",
        "answer validity"
      ],
      "production_gate": false,
      "verdict": "a single small request is always admitted at the configured queue depth; only a saturated burst may be refused (429/529); measured by test_decision_admission.py",
      "control_group": {
        "cases": [
          {
            "input": "single small request",
            "expect": "admitted"
          },
          {
            "input": "burst above the queue depth",
            "expect": "429 or 529 with Retry-After"
          }
        ],
        "queue_cap_default": 4,
        "queue_cap_env": "LLAMA_DECISION_MAX_QUEUE"
      }
    },
    "prefix_lru_capacity": {
      "trigger": "prefix state LRU capacity (restore-mode cache)",
      "axis": "operational",
      "may_gate": [
        "state-cache eviction cost"
      ],
      "may_not_gate": [
        "answers",
        "admission",
        "routing"
      ],
      "production_gate": false,
      "verdict": "the restore-mode prefix state cache keeps the most recent entries and evicts the least recent; a hit changes cost only, never an answer",
      "control_group": {
        "cases": [
          {
            "input": "revisit within the capacity",
            "expect": "hit"
          },
          {
            "input": "revisit past the capacity",
            "expect": "miss"
          },
          {
            "input": "a re-prefilled evicted entry",
            "expect": "same answer"
          }
        ],
        "capacity": 4
      }
    },
    "permutations_cap": {
      "trigger": "permutations cap (order de-bias passes)",
      "axis": "task-value",
      "may_gate": [
        "how many order passes run"
      ],
      "may_not_gate": [
        "the winner when the default is used",
        "answers"
      ],
      "production_gate": false,
      "verdict": "the pass count is accepted and capped at 8, one pass is the default, and zero passes is refused; more passes only add cost",
      "control_group": {
        "cases": [
          {
            "input": "two passes",
            "expect": "accepted"
          },
          {
            "input": "value above the cap",
            "expect": "accepted and capped at 8"
          },
          {
            "input": "zero passes",
            "expect": "rejected"
          },
          {
            "input": "no permutations field",
            "expect": "default one pass"
          }
        ],
        "cap": 8,
        "default": 1
      }
    },
