{
  "instructions": "Answer each question about this support request from its state.",
  "schema": {
    "category": {
      "type": "enum",
      "choices": ["billing", "technical", "cancellation"],
      "description": "What type of support request is this?"
    },
    "urgent": {
      "type": "boolean",
      "description": "Does this need urgent handling?"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Rate the priority from 1 to 4."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "step": 0.5,
      "aggregate": "mean",
      "description": "How confident is the classification?"
    }
  },
  "contexts": ["I was charged twice and need this fixed today."]
}
